# ELO-17 dashboard config. Copy to .env.local and fill in.
#
# PUBLIC (safe in the browser): the Supabase project URL + anon/publishable key.
# RLS makes the anon key read-only on the observable tables and denies all writes,
# so shipping it to the client is intentional and safe.
NEXT_PUBLIC_SUPABASE_URL=https://yafulngyxgzypcouutqt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY (never shipped to the browser). The kill-switch server action presents
# this shared secret to the dashboard-rpc Edge Function's `control` op. It is scoped
# to control-only (it cannot publish bot_state/audit rows). The Supabase service-role
# key is NEVER placed here — it lives inside the Edge Function on Supabase.
DASHBOARD_CONTROL_SECRET=

# SERVER-ONLY operator login (HTTP Basic Auth). REQUIRED — the dashboard fails closed
# (503) until both are set, so the privileged kill-switch is never served open. The
# whole app (read panels + control action) sits behind this single operator credential.
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# Optional: comma-separated market ids to display. Defaults to every market the bot
# has published a bot_state row for.
# DASHBOARD_MARKETS=0
